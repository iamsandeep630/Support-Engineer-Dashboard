BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# GitHub Integration (Code Analysis Agent)
GITHUB_REPO=iamsandeep630/Meridian-Enterprise-Application
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat
